@startuml
skinparam roundcorner 8
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #2B6CB0
  RoundCorner 8
}

skinparam database {
  BackgroundColor #EBF8FF
  BorderColor #2B6CB0
}

skinparam queue {
  BackgroundColor #FEFCBF
  BorderColor #D69E2E
}

skinparam cloud {
  BackgroundColor #EDF2F7
  BorderColor #718096
}

title Architecture Globale OmniShop - Vue Système & Microservices

cloud "Clients & Interfaces" {
  actor "Client (Acheteur)" as Client
  actor "Marchand (Vendeur)" as Marchand
  actor "Administrateur" as Admin
  [Frontend Web (React/Next.js)] as WebApp
  [Frontend Mobile] as MobileApp
}

Client --> WebApp
Marchand --> WebApp
Admin --> WebApp
Client --> MobileApp

rectangle "Périmètre Sécurisé OmniShop" {

  rectangle "Point d'Entrée & Sécurité" as GatewayZone {
    [API Gateway\n(Routage, Rate-Limiting, SSL)] as Gateway
    note right of Gateway
      Validation JWT stateless
      via JWKS en cache
    end note
  }

  WebApp --> Gateway : HTTPS / REST
  MobileApp --> Gateway : HTTPS / REST

  rectangle "Microservice Commun & Sécurité" as IAMZone {
    [Identity & Access Service\n(auth-user-service)] as AuthService
    database "PostgreSQL\n(Users, Roles, RBAC)" as DB_Auth
    database "Redis\n(Sessions & Refresh Tokens)" as Redis_Auth
    AuthService --> DB_Auth
    AuthService --> Redis_Auth
  }

  rectangle "Microservices Métier" as CoreServices {
    [Catalog & Pricing Service\n(Stocks, Grilles B2B/B2C)] as CatalogService
    database "MongoDB\n(Catalogue & Produits)" as DB_Catalog
    CatalogService --> DB_Catalog

    [Order & Cart Service\n(Paniers, Commandes)] as OrderService
    database "PostgreSQL\n(Orders, Invoices)" as DB_Order
    OrderService --> DB_Order

    [Store & Merchant Service\n(Boutiques, Litiges)] as StoreService
    database "PostgreSQL\n(Stores, Contracts)" as DB_Store
    StoreService --> DB_Store
  }

  queue "Message Broker (RabbitMQ / Kafka)\nBus d'Événements Asynchrones" as Broker

  cloud "Fournisseurs Externes" as ThirdParty {
    [OAuth2 Providers\n(Google, GitHub)] as OAuthProviders
    [Passerelle Paiement\n(Stripe / PayPal)] as PaymentGateway
  }
}

' Routage Gateway
Gateway --> AuthService : /api/v1/auth/*
Gateway --> CatalogService : /api/v1/catalog/*
Gateway --> OrderService : /api/v1/orders/*
Gateway --> StoreService : /api/v1/stores/*

' Connexions externes
AuthService --> OAuthProviders : OAuth2 / OpenID Connect
OrderService --> PaymentGateway : Traitement cartes & virements

' Événements Asynchrones
AuthService .down.> Broker : UserRegisteredEvent\nUserSuspendedEvent
Broker .up.> StoreService : Consomme UserRegistered
Broker .up.> OrderService : Notifications internes
OrderService .down.> Broker : OrderPlacedEvent
Broker .up.> CatalogService : Décrémentation Stock

@enduml
